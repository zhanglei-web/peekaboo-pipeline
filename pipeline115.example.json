  "preprocessing_inventory": "/absolute/path/to/input/preprocessing_inventory.json",
  "facts": null,
  "astra_config": "/absolute/path/to/config/selector.json",
  "routes": {
    "scene": "local",
    "events": "local",
    "temporal": "local"
  },
